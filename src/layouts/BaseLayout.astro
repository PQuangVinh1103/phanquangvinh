---
import '../styles/global.css';
import { SITE, SOCIAL, NAV, MODULES, WEBINAR, isWebinarOpen, tracked } from '../config/site';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  publishedAt?: Date;
  jsonLd?: object | object[];
}

const { title, description = SITE.description, image = SITE.defaultOg, type = 'website', noindex = false, publishedAt, jsonLd } = Astro.props;

const path = Astro.url.pathname;
const canonical = new URL(path === '/' ? '/' : path.replace(/\/$/, ''), SITE.url).toString();
const fullTitle = title.includes(SITE.name) ? title : `${title} | ${SITE.name}`;
const ogImage = image.startsWith('http') ? image : new URL(image, SITE.url).toString();

const isActive = (href: string) => path === href || path.startsWith(`${href}/`) || (href === '/bai-viet' && path.startsWith('/chuyen-muc'));
const schemas = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const webinarOpen = isWebinarOpen();
const year = new Date().getFullYear();
---
<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex, nofollow" />}
  <meta name="theme-color" content="#15381c" />

  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
  <link rel="shortcut icon" href="/favicon.ico" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="alternate" type="application/rss+xml" title={`${SITE.name} — Bài viết`} href="/rss.xml" />

  <meta property="og:site_name" content={`${SITE.brand} · ${SITE.name}`} />
  <meta property="og:locale" content="vi_VN" />
  <meta property="og:type" content={type} />
  <meta property="og:url" content={canonical} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />
  {publishedAt && <meta property="article:published_time" content={publishedAt.toISOString()} />}
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Lora:ital,wght@0,500;0,600;0,700;1,500;1,600&family=Oswald:wght@500;600&display=swap" rel="stylesheet" />

  {schemas.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
</head>
<body>
  <a class="skip-link" href="#main">Bỏ qua, tới nội dung</a>

  {webinarOpen && (
    <div class="slim-banner">
      <div class="container">
        <span>☕ {WEBINAR.title} · {WEBINAR.dateLabel}</span>
        <a href={tracked(WEBINAR.url, 'banner-site')} target="_blank" rel="noopener">Giữ chỗ miễn phí →</a>
      </div>
    </div>
  )}

  <header class="site-header">
    <div class="container nav">
      <a class="brand" href="/" aria-label={`${SITE.brand} — ${SITE.name}, trang chủ`}>
        <img class="brand-mark" src="/brand/vinh-nghien-ngam-bieu-tuong-mau.svg" alt="" width="30" height="52" />
        <span class="brand-text">
          <span class="brand-name">{SITE.brand}</span>
          <span class="brand-sub">{SITE.name}</span>
        </span>
      </a>
      <ul class="nav-links">
        {NAV.map((n) => (
          <li><a href={n.href} aria-current={isActive(n.href) ? 'page' : undefined}>{n.label}</a></li>
        ))}
      </ul>
      <div class="nav-cta-wrap">
        <a class="btn btn-dark btn-sm nav-cta" href="/ve-vinh#lien-he">Liên hệ</a>
      </div>
      <button class="nav-toggle" id="nav-toggle" aria-label="Mở menu" aria-expanded="false" aria-controls="mobile-menu">
        <span></span><span></span><span></span>
      </button>
    </div>
    <div class="mobile-menu" id="mobile-menu">
      {NAV.map((n) => (
        <a href={n.href} aria-current={isActive(n.href) ? 'page' : undefined}>{n.label}</a>
      ))}
      <a href="/ve-vinh#lien-he">Liên hệ</a>
    </div>
  </header>

  <main id="main">
    <slot />
  </main>

  <footer class="site-footer">
    <div class="container">
      <div class="footer-grid">
        <div class="footer-col">
          <div class="footer-brand">
            <img src="/brand/vinh-nghien-ngam-bieu-tuong-dao-mau.svg" alt="" width="30" height="52" />
            <span>{SITE.brand}<small>{SITE.name}</small></span>
          </div>
          <p>Ghi lại những gì mình đang làm ở ba mảng: cà phê, DBL Code và tài sản số. Có nguồn, có số, có tình huống thật.</p>
        </div>
        <div class="footer-col">
          <h4>Lĩnh vực</h4>
          <ul>
            {MODULES.map((m) => <li><a href={m.path}>{m.name}</a></li>)}
            <li><a href="/bai-viet">Tất cả bài viết</a></li>
          </ul>
        </div>
        <div class="footer-col">
          <h4>Kết nối</h4>
          <ul>
            {SOCIAL.map((s) => <li><a href={s.url} target="_blank" rel="noopener noreferrer">{s.label}</a></li>)}
          </ul>
        </div>
        <div class="footer-col">
          <h4>Liên hệ</h4>
          <ul>
            <li><a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
            <li><a href={SITE.zalo} target="_blank" rel="noopener noreferrer">Zalo {SITE.zaloPhone}</a></li>
            <li><a href="/rss.xml">RSS bài viết</a></li>
          </ul>
        </div>
      </div>
      <div class="footer-bottom">
        <span>© {year} Phan Quang Vinh · phanquangvinh.com</span>
        <span>Nội dung chia sẻ kiến thức, không phải khuyến nghị đầu tư hay tư vấn pháp lý.</span>
      </div>
    </div>
  </footer>

  <script is:inline>
    (function () {
      var btn = document.getElementById('nav-toggle');
      var menu = document.getElementById('mobile-menu');
      if (!btn || !menu) return;
      btn.addEventListener('click', function () {
        var open = menu.classList.toggle('open');
        btn.setAttribute('aria-expanded', String(open));
      });
    })();
  </script>
</body>
</html>
