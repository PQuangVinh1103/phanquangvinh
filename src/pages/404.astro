---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Không tìm thấy trang" noindex>
  <section class="page-404">
    <div class="container">
      <h1>404</h1>
      <p style="margin:12px 0 24px;color:var(--muted)">Trang này không tồn tại hoặc đã đổi địa chỉ.</p>
      <div class="btn-row" style="justify-content:center">
        <a class="btn btn-dark" href="/">Về trang chủ</a>
        <a class="btn btn-outline" href="/bai-viet">Xem bài viết</a>
      </div>
    </div>
  </section>
</BaseLayout>
