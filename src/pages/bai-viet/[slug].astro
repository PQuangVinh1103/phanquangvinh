---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import NewsletterForm from '../../components/NewsletterForm.astro';
import { SITE, categoryOf } from '../../config/site';
import { formatDate, getPublishedPosts, isPublished, readingTime } from '../../lib/posts';

const { slug } = Astro.params;
const post = slug ? await getEntry('posts', slug) : undefined;
if (!post || !isPublished(post)) return Astro.redirect('/bai-viet');

const { Content } = await render(post);
const d = post.data;
const cat = categoryOf(d.category);
const url = `${SITE.url}/bai-viet/${post.id}`;
const image = d.coverImage ?? SITE.defaultOg;
const related = (await getPublishedPosts(d.category)).filter((p) => p.id !== post.id).slice(0, 3);
const shareUrl = `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(url)}`;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: d.title,
    description: d.seoDescription || d.excerpt,
    image: [new URL(image, SITE.url).toString()],
    datePublished: d.publishedAt.toISOString(),
    dateModified: (d.updatedAt ?? d.publishedAt).toISOString(),
    author: { '@type': 'Person', name: SITE.name, url: SITE.url },
    publisher: { '@type': 'Person', name: SITE.name },
    mainEntityOfPage: url,
    inLanguage: 'vi',
    keywords: d.tags.join(', ') || undefined,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Trang chủ', item: SITE.url },
      { '@type': 'ListItem', position: 2, name: 'Bài viết', item: `${SITE.url}/bai-viet` },
      { '@type': 'ListItem', position: 3, name: cat.name, item: `${SITE.url}/chuyen-muc/${cat.slug}` },
      { '@type': 'ListItem', position: 4, name: d.title, item: url },
    ],
  },
];
const cleanSources = d.sources.filter((s) => s.title.trim());
---
<BaseLayout title={d.seoTitle || d.title} description={d.seoDescription || d.excerpt} image={image} type="article" publishedAt={d.publishedAt} jsonLd={jsonLd}>
  <article>
    <header class="article-head">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Trang chủ</a> / <a href="/bai-viet">Bài viết</a> / <a href={`/chuyen-muc/${cat.slug}`}>{cat.name}</a>
      </nav>
      <a class="pill" data-cat={cat.slug} href={`/chuyen-muc/${cat.slug}`}>{cat.name}</a>
      <h1>{d.title}</h1>
      <p class="article-excerpt">{d.excerpt}</p>
      <div class="article-meta">
        <span>{SITE.name}</span>
        <time datetime={d.publishedAt.toISOString()}>{formatDate(d.publishedAt)}</time>
        <span>{readingTime(post)}</span>
        {d.verified && <span class="badge-ok">✔ Đã kiểm nguồn</span>}
        {d.hasAssumption && <span class="badge-warn">Có số giả định</span>}
      </div>
    </header>

    {d.coverImage && (
      <div class="article-cover"><img src={d.coverImage} alt={d.title} width="1200" height="675" fetchpriority="high" /></div>
    )}

    <div class="article-wrap">
      <div class="prose" style={d.textAlign === 'justify' ? 'text-align:justify' : undefined}>
        <Content />
      </div>

      {d.videoUrl && (
        <p class="notice">Video liên quan: <a href={d.videoUrl} target="_blank" rel="noopener noreferrer">{d.videoUrl}</a></p>
      )}

      {d.hasAssumption && (
        <div class="notice warn" style="margin-top:12px">Các con số ghi “giả định” trong bài là số tự đặt để minh họa, không phải số liệu thực tế.</div>
      )}

      {cleanSources.length > 0 && (
        <div class="notice" style="margin-top:12px">
          <h4>Nguồn tham khảo</h4>
          <ul>
            {cleanSources.map((s) => (
              <li>
                {s.url ? <a href={s.url} target="_blank" rel="noopener noreferrer">{s.title}</a> : s.title}
                {s.date ? ` (${s.date})` : ''}
              </li>
            ))}
          </ul>
        </div>
      )}

      {cat.disclaimer && <div class="notice" style="margin-top:12px">{cat.disclaimer}</div>}

      <div class="btn-row" style="margin-top:22px">
        <a class="btn btn-outline btn-sm" href={shareUrl} target="_blank" rel="noopener noreferrer">Chia sẻ lên Facebook</a>
        <a class="btn btn-outline btn-sm" href={`/chuyen-muc/${cat.slug}`}>Thêm bài mục {cat.name}</a>
      </div>

      <aside class="author-box">
        <img src="/pictures/opt/vinh-portrait.jpg" alt="Phan Quang Vinh" width="68" height="68" loading="lazy" />
        <p><strong>Phan Quang Vinh (Kelvin)</strong><br />Làm ba mảng: cà phê, DBL Code, tài sản số. <a href="/ve-vinh">Về Vinh</a></p>
      </aside>
    </div>
  </article>

  {related.length > 0 && (
    <section class="section">
      <div class="container">
        <div class="section-head"><h2 class="section-title">Bài liên quan</h2></div>
        <div class="grid grid-3">{related.map((p) => <PostCard post={p} />)}</div>
      </div>
    </section>
  )}

  <section class="section-tight">
    <div class="container"><NewsletterForm source={`bai-${post.id}`} /></div>
  </section>
</BaseLayout>
