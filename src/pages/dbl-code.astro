---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
import { DBL, MODULES, SITE } from '../config/site';
import { getPublishedPosts } from '../lib/posts';

const mod = MODULES.find((m) => m.slug === 'dbl-code')!;
const posts = (await getPublishedPosts('dbl-code')).slice(0, 3);

const channels = [
  { t: 'YouTube DBL Code', d: 'Những video dài, đi kỹ vào một vấn đề về con người và công việc, để bạn hiểu sâu thay vì lướt qua.' },
  { t: 'DBL Career · Sói Học Việc', d: 'Chuyện công sở và chọn hướng đi, dành cho người trẻ đang tìm đường trong những năm đầu đi làm.' },
  { t: 'DBL Invest', d: 'Góc nhìn tâm lý trong tài chính cá nhân: vì sao ta quyết định chuyện tiền bạc như vậy, và làm sao để tỉnh táo hơn.' },
  { t: 'DBL Code · Giải mã chiến lược', d: 'Những case study được mổ xẻ kỹ, để rút ra bài học về chiến lược và con người đứng phía sau.' },
  { t: 'Cộng đồng Facebook', d: 'Nơi bạn đặt câu hỏi và trao đổi cùng những người cũng đang muốn hiểu mình hơn.' },
];

const funnel = [
  { n: '01', t: 'Nội dung chia sẻ', d: 'Video, podcast, bài viết giúp bạn làm quen với cách DBL Code nhìn con người.' },
  { n: '02', t: 'DBL Strategy Report', d: 'Một bản báo cáo riêng về năng lực và tiềm năng của bạn.' },
  { n: '03', t: 'Đồng hành 1-1', d: 'Cùng chuyên gia đi sâu vào hướng đi cụ thể của bạn.' },
];

const jsonLd = { '@context': 'https://schema.org', '@type': 'CollectionPage', name: 'DBL Code — Phan Quang Vinh', url: `${SITE.url}/dbl-code`, description: mod.blurb };
---
<BaseLayout title="DBL Code: giải mã năng lực, dùng người đúng" description="DBL Code là hệ thống giải mã năng lực và khai phá tiềm năng con người, kết hợp DISC, thần số học, nhóm máu và tâm lý học hành vi." jsonLd={jsonLd}>
  <section class="mod-hero" data-mod="dbl-code">
    <div class="container">
      <span class="eyebrow on-dark">Lĩnh vực 02 · DBL Code™</span>
      <h1>Hiểu người đúng để <span class="accent">dùng người đúng.</span></h1>
      <p class="lead">
        DBL Code là hệ thống giải mã năng lực và khai phá tiềm năng con người, kết hợp DISC, thần số học, nhóm máu và tâm lý học hành vi. Mình thiết kế sản phẩm và lan tỏa giá trị của hệ thống này tới từng người.
      </p>
      <div class="btn-row">
        <a class="btn btn-primary" href={DBL.url} target="_blank" rel="noopener">Tới dblcode.com</a>
        <a class="btn btn-outline on-dark" href="/chuyen-muc/dbl-code">Đọc bài về DBL Code</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="grid grid-2">
        <div>
          <span class="eyebrow">Vai trò của mình</span>
          <h2 class="section-title">Mình đồng hành cùng DBL Code thế nào</h2>
          <div class="card" style="margin-top:20px;padding:26px">
            <p>Mình thiết kế sản phẩm và lan tỏa giá trị của DBL Code, cùng một tinh thần đồng hành.</p>
            <p>Với mỗi cá nhân, đó là giúp bạn đưa ra những quyết định lớn về cuộc sống và sự nghiệp sao cho đúng với chính mình.</p>
            <p>Với doanh nghiệp, đó là giúp lựa chọn và tối ưu các quyết định về nhân sự, từ tuyển dụng, lãnh đạo đến phát triển đội ngũ.</p>
          </div>
        </div>
        <div>
          <span class="eyebrow">Phương pháp</span>
          <h2 class="section-title">Bốn lớp để hiểu một con người</h2>
          <div class="grid grid-2" style="margin-top:20px">
            <div class="stat"><b>DISC</b><span>Phong cách hành vi: cách bạn giao tiếp, quyết định và làm việc cùng người khác</span></div>
            <div class="stat"><b>Thần số học</b><span>Sứ mệnh: hướng đi và giá trị cốt lõi bạn theo đuổi</span></div>
            <div class="stat"><b>Nhóm máu</b><span>Bản năng: cách bạn phản ứng trước áp lực</span></div>
            <div class="stat"><b>Tâm lý học</b><span>Khoa học nghiên cứu hành vi: vì sao con người hành động như vậy</span></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Hành trình</span>
        <h2 class="section-title">Từ làm quen đến đồng hành sâu hơn</h2>
      </div>
      <div class="grid grid-3">
        {funnel.map((f) => (
          <article class="card num-card">
            <span class="num">{f.n}</span>
            <h3>{f.t}</h3>
            <p>{f.d}</p>
          </article>
        ))}
      </div>
      <div class="btn-row" style="margin-top:28px">
        <a class="btn btn-dark" href={DBL.url} target="_blank" rel="noopener">Tìm hiểu DBL Strategy Report</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Nơi mình chia sẻ</span>
        <h2 class="section-title">Mỗi nơi giúp bạn một việc</h2>
      </div>
      <div class="grid grid-2">
        {channels.map((c, i) => (
          <article class="card pillar" data-mod="dbl-code" style={i === channels.length - 1 && channels.length % 2 === 1 ? 'grid-column:1/-1' : undefined}>
            <h3>{c.t}</h3>
            <p>{c.d}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Bài viết</span>
        <h2 class="section-title">Mới nhất về DBL Code</h2>
      </div>
      {posts.length > 0
        ? <div class="grid grid-3">{posts.map((p) => <PostCard post={p} />)}</div>
        : <div class="empty"><strong>Chưa có bài nào ở mục này.</strong>Bài đầu tiên sẽ sớm lên.</div>}
      <div class="btn-row" style="margin-top:28px"><a class="btn btn-outline" href="/chuyen-muc/dbl-code">Xem tất cả</a></div>
    </div>
  </section>

  <section class="section-tight">
    <div class="container"><NewsletterForm source="dbl-code" heading="Nhận bài về DBL Code qua email" /></div>
  </section>
</BaseLayout>
