---
import { getCollection } from 'astro:content';

const getPostSlug = (id: string) => id.replace(/\.(md|mdoc)$/, '');
const formatDate = (date: Date) =>
  new Intl.DateTimeFormat('vi-VN', { month: 'short', day: 'numeric', year: 'numeric' }).format(date);

const posts = (await getCollection('posts'))
  .filter((p) => p.data.status === 'published')
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf())
  .slice(0, 3);
---
<!DOCTYPE html>
<html lang="vi">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Kelvin (Phan Quang Vinh) — Biến AI thành đòn bẩy tự chủ</title>
  <meta name="description" content="Hướng dẫn biến AI và tự động hóa thành đòn bẩy thực chiến trong công việc: bớt việc lặp lại, tối ưu quy trình và làm chủ thời gian của chính bạn." />
  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="icon" type="image/png" href="/favicon.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,600;12..96,700;12..96,800&family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet" />

  <style>
    /* =========================================
       DESIGN TOKENS — ELECTRIC COBALT SYSTEM
    ========================================= */
    :root {
      --brand-blue: #0066FF;
      --brand-blue-glow: rgba(0, 102, 255, 0.25);
      --brand-blue-soft: #EEF4FF;
      --brand-blue-dark: #004ecc;
      
      --bg-main: #FAFAFA;
      --bg-card: #FFFFFF;
      --bg-card-hover: #F8FAFC;
      --bg-dark: #0C0F17;
      
      --text-main: #0F172A;
      --text-muted: #64748B;
      --text-subtle: #94A3B8;
      --text-inverted: #FFFFFF;
      
      --border-light: #E2E8F0;
      --border-subtle: #F1F5F9;
      
      --font-display: 'Bricolage Grotesque', -apple-system, sans-serif;
      --font-sans: 'Plus Jakarta Sans', -apple-system, sans-serif;
      
      --radius-sm: 8px;
      --radius-md: 14px;
      --radius-lg: 24px;
      --radius-full: 9999px;
      
      --shadow-soft: 0 4px 20px -2px rgba(0, 0, 0, 0.05);
      --shadow-hover: 0 12px 30px -4px rgba(0, 102, 255, 0.12);
      --shadow-float: 0 20px 40px -10px rgba(12, 15, 23, 0.15);
      
      --max-width: 1160px;
    }

    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      scroll-behavior: smooth;
      font-size: 16px;
    }

    body {
      background-color: var(--bg-main);
      color: var(--text-main);
      font-family: var(--font-sans);
      line-height: 1.6;
      -webkit-font-smoothing: antialiased;
      overflow-x: hidden;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    .container {
      width: 100%;
      max-width: var(--max-width);
      margin: 0 auto;
      padding: 0 1.5rem;
    }

    /* =========================================
       HEADER NAVIGATION
    ========================================= */
    .site-header {
      position: sticky;
      top: 0;
      z-index: 100;
      background: rgba(250, 250, 250, 0.85);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--border-subtle);
      transition: all 0.2s ease;
    }

    .header-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      height: 72px;
    }

    .brand-logo {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      font-family: var(--font-display);
      font-weight: 800;
      font-size: 1.35rem;
      letter-spacing: -0.02em;
      color: var(--text-main);
    }

    .brand-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: var(--brand-blue);
      display: inline-block;
      box-shadow: 0 0 10px var(--brand-blue);
    }

    .nav-links {
      display: flex;
      align-items: center;
      gap: 2rem;
      list-style: none;
    }

    .nav-link {
      font-size: 0.95rem;
      font-weight: 500;
      color: var(--text-muted);
      transition: color 0.15s ease;
    }

    .nav-link:hover {
      color: var(--brand-blue);
    }

    .nav-cta {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      padding: 0.55rem 1.1rem;
      background: var(--text-main);
      color: var(--text-inverted);
      font-size: 0.9rem;
      font-weight: 600;
      border-radius: var(--radius-full);
      transition: all 0.2s ease;
    }

    .nav-cta:hover {
      background: var(--brand-blue);
      transform: translateY(-1px);
      box-shadow: 0 4px 12px var(--brand-blue-glow);
    }

    /* =========================================
       HERO SECTION (CLIENT-CENTRIC)
    ========================================= */
    .hero-section {
      padding: 4.5rem 0 4rem;
      position: relative;
    }

    .hero-grid {
      display: grid;
      grid-template-columns: 1.15fr 0.85fr;
      gap: 3.5rem;
      align-items: center;
    }

    .hero-copy {
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
    }

    .hero-headline {
      font-family: var(--font-display);
      font-size: clamp(2.4rem, 4.5vw, 3.8rem);
      font-weight: 800;
      line-height: 1.12;
      letter-spacing: -0.03em;
      color: var(--text-main);
    }

    .hero-headline .highlight-blue {
      color: var(--brand-blue);
      position: relative;
      display: inline-block;
    }

    .hero-description {
      font-size: clamp(1.05rem, 1.3vw, 1.2rem);
      color: var(--text-muted);
      line-height: 1.65;
      max-width: 540px;
    }

    .hero-actions {
      display: flex;
      align-items: center;
      gap: 1rem;
      flex-wrap: wrap;
      margin-top: 0.5rem;
    }

    .btn-primary {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      padding: 0.9rem 1.8rem;
      background: var(--brand-blue);
      color: var(--text-inverted);
      font-weight: 700;
      font-size: 1rem;
      border-radius: var(--radius-full);
      box-shadow: 0 8px 24px var(--brand-blue-glow);
      transition: all 0.2s ease;
    }

    .btn-primary:hover {
      background: var(--brand-blue-dark);
      transform: translateY(-2px);
      box-shadow: 0 12px 28px rgba(0, 102, 255, 0.35);
    }

    .btn-secondary {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      padding: 0.9rem 1.6rem;
      background: var(--bg-card);
      color: var(--text-main);
      font-weight: 600;
      font-size: 0.95rem;
      border: 1px solid var(--border-light);
      border-radius: var(--radius-full);
      transition: all 0.2s ease;
    }

    .btn-secondary:hover {
      border-color: var(--brand-blue);
      color: var(--brand-blue);
      background: var(--brand-blue-soft);
      transform: translateY(-1px);
    }

    .hero-badges {
      display: flex;
      align-items: center;
      gap: 1.25rem;
      padding-top: 1rem;
      border-top: 1px solid var(--border-light);
      margin-top: 0.5rem;
      flex-wrap: wrap;
    }

    .hero-badge-item {
      display: flex;
      align-items: center;
      gap: 0.4rem;
      font-size: 0.85rem;
      font-weight: 600;
      color: var(--text-muted);
    }

    .hero-badge-item svg {
      color: var(--brand-blue);
    }

    /* HERO VISUAL (KELVIN PHOTO WITH TECH GRID & AUTOMATION BADGE) */
    .hero-visual {
      position: relative;
    }

    .portrait-card {
      position: relative;
      border-radius: var(--radius-lg);
      overflow: hidden;
      background: #0F172A;
      box-shadow: var(--shadow-float);
      aspect-ratio: 4/5;
      border: 1px solid rgba(255, 255, 255, 0.1);
    }

    .portrait-img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center 20%;
      display: block;
      filter: contrast(1.05);
    }

    /* Tech Grid Overlay */
    .tech-grid-overlay {
      position: absolute;
      inset: 0;
      background-image: 
        linear-gradient(to right, rgba(0, 102, 255, 0.08) 1px, transparent 1px),
        linear-gradient(to bottom, rgba(0, 102, 255, 0.08) 1px, transparent 1px);
      background-size: 24px 24px;
      pointer-events: none;
    }

    .tech-glow-overlay {
      position: absolute;
      inset: 0;
      background: radial-gradient(circle at 80% 90%, rgba(0, 102, 255, 0.4) 0%, transparent 65%),
                  linear-gradient(to top, rgba(12, 15, 23, 0.8) 0%, transparent 50%);
      pointer-events: none;
    }

    /* Floating Automation Badge */
    .automation-float-card {
      position: absolute;
      bottom: -20px;
      left: -20px;
      background: rgba(255, 255, 255, 0.95);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border: 1px solid rgba(255, 255, 255, 0.8);
      border-radius: var(--radius-md);
      padding: 1rem 1.25rem;
      box-shadow: 0 16px 36px rgba(0, 0, 0, 0.12);
      max-width: 280px;
      animation: floatSlow 5s ease-in-out infinite alternate;
    }

    @keyframes floatSlow {
      0% { transform: translateY(0px); }
      100% { transform: translateY(-6px); }
    }

    .float-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 0.5rem;
    }

    .pulse-status {
      display: flex;
      align-items: center;
      gap: 0.4rem;
      font-size: 0.75rem;
      font-weight: 700;
      color: var(--brand-blue);
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .pulse-dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: var(--brand-blue);
      box-shadow: 0 0 8px var(--brand-blue);
      animation: pulse 2s infinite;
    }

    @keyframes pulse {
      0%, 100% { opacity: 1; transform: scale(1); }
      50% { opacity: 0.4; transform: scale(0.85); }
    }

    .float-body {
      font-size: 0.88rem;
      font-weight: 600;
      color: var(--text-main);
      line-height: 1.4;
    }

    .float-metric {
      display: inline-block;
      margin-top: 0.35rem;
      font-size: 0.78rem;
      color: var(--text-muted);
      font-weight: 500;
    }

    /* =========================================
       SECTION: FEATURED RESOURCES / GUIDES
    ========================================= */
    .section {
      padding: 5rem 0;
    }

    .section-header {
      margin-bottom: 2.75rem;
    }

    .section-title {
      font-family: var(--font-display);
      font-size: clamp(1.8rem, 3vw, 2.4rem);
      font-weight: 800;
      letter-spacing: -0.02em;
      color: var(--text-main);
      margin-bottom: 0.5rem;
    }

    .section-subtitle {
      font-size: 1.05rem;
      color: var(--text-muted);
      max-width: 600px;
    }

    .resources-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
      gap: 1.75rem;
    }

    .resource-card {
      background: var(--bg-card);
      border: 1px solid var(--border-light);
      border-radius: var(--radius-md);
      padding: 1.75rem;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      transition: all 0.25s ease;
      box-shadow: var(--shadow-soft);
      position: relative;
    }

    .resource-card:hover {
      border-color: var(--brand-blue);
      transform: translateY(-4px);
      box-shadow: var(--shadow-hover);
    }

    .resource-tag {
      display: inline-block;
      padding: 0.3rem 0.75rem;
      background: var(--brand-blue-soft);
      color: var(--brand-blue);
      font-size: 0.78rem;
      font-weight: 700;
      border-radius: var(--radius-full);
      margin-bottom: 1rem;
      align-self: flex-start;
    }

    .resource-title {
      font-family: var(--font-display);
      font-size: 1.3rem;
      font-weight: 700;
      line-height: 1.35;
      color: var(--text-main);
      margin-bottom: 0.75rem;
    }

    .resource-desc {
      font-size: 0.92rem;
      color: var(--text-muted);
      line-height: 1.6;
      margin-bottom: 1.5rem;
    }

    .resource-link {
      display: flex;
      align-items: center;
      gap: 0.4rem;
      font-size: 0.9rem;
      font-weight: 700;
      color: var(--brand-blue);
      margin-top: auto;
    }

    .resource-link svg {
      transition: transform 0.2s ease;
    }

    .resource-card:hover .resource-link svg {
      transform: translateX(4px);
    }

    /* =========================================
       SECTION: THREE WAYS I CAN HELP
    ========================================= */
    .help-section {
      background: #F1F5F9;
      border-top: 1px solid var(--border-light);
      border-bottom: 1px solid var(--border-light);
      padding: 5rem 0;
    }

    .help-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: 1.5rem;
    }

    .help-card {
      background: var(--bg-card);
      border: 1px solid var(--border-light);
      border-radius: var(--radius-md);
      padding: 2rem;
      transition: all 0.2s ease;
    }

    .help-card:hover {
      border-color: var(--brand-blue);
      box-shadow: var(--shadow-hover);
    }

    .help-number {
      font-family: var(--font-display);
      font-size: 2.2rem;
      font-weight: 800;
      color: var(--brand-blue);
      line-height: 1;
      margin-bottom: 1rem;
      opacity: 0.9;
    }

    .help-card-title {
      font-family: var(--font-display);
      font-size: 1.25rem;
      font-weight: 700;
      color: var(--text-main);
      margin-bottom: 0.6rem;
    }

    .help-card-desc {
      font-size: 0.92rem;
      color: var(--text-muted);
      line-height: 1.6;
    }

    /* =========================================
       SECTION: ABOUT KELVIN (HELPER STORY)
    ========================================= */
    .about-section {
      padding: 5rem 0;
    }

    .about-box {
      background: var(--bg-card);
      border: 1px solid var(--border-light);
      border-radius: var(--radius-lg);
      padding: 3rem;
      box-shadow: var(--shadow-soft);
      display: grid;
      grid-template-columns: 1fr 1.5fr;
      gap: 3rem;
      align-items: center;
    }

    .about-visual-small {
      border-radius: var(--radius-md);
      overflow: hidden;
      aspect-ratio: 1/1;
      background: #0F172A;
      position: relative;
    }

    .about-visual-small img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .about-content h2 {
      font-family: var(--font-display);
      font-size: 2rem;
      font-weight: 800;
      color: var(--text-main);
      margin-bottom: 1rem;
    }

    .about-content p {
      font-size: 1rem;
      color: var(--text-muted);
      line-height: 1.7;
      margin-bottom: 1.2rem;
    }

    .about-content .about-quote {
      font-size: 1.05rem;
      font-weight: 600;
      color: var(--brand-blue);
      border-left: 3px solid var(--brand-blue);
      padding-left: 1rem;
      margin-top: 1.5rem;
    }

    /* =========================================
       FOOTER
    ========================================= */
    .site-footer {
      background: var(--bg-card);
      border-top: 1px solid var(--border-light);
      padding: 3rem 0;
      font-size: 0.9rem;
      color: var(--text-muted);
    }

    .footer-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 1.5rem;
    }

    .footer-links {
      display: flex;
      align-items: center;
      gap: 1.5rem;
    }

    .footer-link:hover {
      color: var(--brand-blue);
    }

    /* =========================================
       RESPONSIVE BREAKPOINTS
    ========================================= */
    @media (max-width: 900px) {
      .hero-grid {
        grid-template-columns: 1fr;
        gap: 2.5rem;
      }

      .hero-visual {
        max-width: 420px;
        margin: 0 auto;
      }

      .automation-float-card {
        bottom: -15px;
        left: 10px;
        right: 10px;
        max-width: none;
      }

      .about-box {
        grid-template-columns: 1fr;
        padding: 2rem;
        gap: 2rem;
      }

      .about-visual-small {
        max-width: 240px;
      }
    }

    @media (max-width: 640px) {
      .nav-links {
        display: none;
      }

      .hero-section {
        padding: 3rem 0 2.5rem;
      }

      .hero-actions {
        flex-direction: column;
        align-items: stretch;
      }

      .btn-primary, .btn-secondary {
        width: 100%;
      }
    }
  </style>
</head>

<body>

  <!-- HEADER NAVIGATION -->
  <header class="site-header">
    <div class="container">
      <div class="header-inner">
        <a href="/" class="brand-logo">
          <span>Kelvin</span>
          <span class="brand-dot"></span>
        </a>
        
        <nav>
          <ul class="nav-links">
            <li><a href="#resources" class="nav-link">Tài liệu & Cẩm nang</a></li>
            <li><a href="#how-i-help" class="nav-link">Cách tôi giúp bạn</a></li>
            <li><a href="#about" class="nav-link">Về Kelvin</a></li>
          </ul>
        </nav>

        <a href="https://zalo.me/g/vjrvtu846" target="_blank" rel="noopener noreferrer" class="nav-cta">
          <span>Vào Nhóm Zalo</span>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17L17 7"/><path d="M7 7h10v10"/></svg>
        </a>
      </div>
    </div>
  </header>

  <main>
    <!-- HERO SECTION -->
    <section class="hero-section">
      <div class="container">
        <div class="hero-grid">
          
          <!-- LEFT: COPYWRITING -->
          <div class="hero-copy">
            <h1 class="hero-headline">
              Thời gian của bạn không sinh ra để <span class="highlight-blue">làm việc lặp lại.</span>
            </h1>

            <p class="hero-description">
              Hướng dẫn biến AI và tự động hóa thành đòn bẩy tự chủ cho công việc của bạn: bớt thao tác thủ công, tối ưu quy trình và làm chủ thời gian của chính mình.
            </p>

            <div class="hero-actions">
              <a href="#resources" class="btn-primary">
                <span>Khám phá tài liệu & quy trình</span>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
              </a>
              <a href="https://zalo.me/g/vjrvtu846" target="_blank" rel="noopener noreferrer" class="btn-secondary">
                <span>Tham gia nhóm Zalo kết nối</span>
              </a>
            </div>

            <div class="hero-badges">
              <div class="hero-badge-item">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
                <span>Tư duy gốc trước khi prompt</span>
              </div>
              <div class="hero-badge-item">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
                <span>Hệ thống tự động thực chiến</span>
              </div>
              <div class="hero-badge-item">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg>
                <span>Không lý thuyết suông</span>
              </div>
            </div>
          </div>

          <!-- RIGHT: KELVIN PORTRAIT WITH TECH GRID LAYER -->
          <div class="hero-visual">
            <div class="portrait-card">
              <img 
