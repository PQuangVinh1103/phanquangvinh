---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
import WebinarPromo from '../components/WebinarPromo.astro';
import { SITE, SOCIAL, MODULES } from '../config/site';
import { getPublishedPosts } from '../lib/posts';

const latest = (await getPublishedPosts()).slice(0, 3);

const pillars = [
  {
    mod: 'ca-phe',
    no: 'Mảng 01',
    title: 'Cà phê',
    text: 'Chuyện thị trường cà phê và kinh doanh quanh ly cà phê. Mình tìm hiểu, kể lại có nguồn. Từ đó mở ra webinar và khóa học về thị trường hàng hóa.',
    points: ['Kênh Vinh Nghiền Ngẫm ☕', 'Webinar miễn phí', 'Khóa Bí Mật Giao Dịch Cà Phê Robusta'],
    cta: 'Vào mảng Cà phê',
  },
  {
    mod: 'dbl-code',
    no: 'Mảng 02',
    title: 'DBL Code',
    text: 'Hệ thống giải mã năng lực con người. Mình là Manager: bao quát vận hành, lên kế hoạch, giao việc cho đội content, marketing, HR và kinh doanh.',
    points: ['DISC + thần số học + tâm lý hành vi', 'DBL Strategy Report', 'Hệ sinh thái kênh nội dung'],
    cta: 'Vào mảng DBL Code',
  },
  {
    mod: 'tai-san-so',
    no: 'Mảng 03',
    title: 'Tài sản số',
    text: 'Tài sản mã hóa (TSMH), RWA và khung pháp lý tại Việt Nam. Giải thích bằng ngôn ngữ thường, dẫn về văn bản gốc.',
    points: ['TSMH và RWA là gì', 'Nghị quyết 05/NQ-CP', 'Thuật ngữ và vai trò các bên'],
    cta: 'Vào mảng Tài sản số',
  },
];

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: SITE.name,
  alternateName: SITE.nickname,
  url: SITE.url,
  image: new URL(SITE.portrait, SITE.url).toString(),
  brand: SITE.brand,
  sameAs: SOCIAL.map((s) => s.url),
};
const website = { '@context': 'https://schema.org', '@type': 'WebSite', name: SITE.name, url: SITE.url, inLanguage: 'vi' };
---
<BaseLayout title="Phan Quang Vinh — Cà phê, DBL Code, Tài sản số" description={SITE.description} jsonLd={[person, website]}>
  <section class="hero">
    <div class="container hero-grid">
      <div>
        <span class="eyebrow">Phan Quang Vinh · Kelvin</span>
        <h1>Ba mảng mình đang làm thật: <span class="accent">cà phê, DBL Code, tài sản số.</span></h1>
        <p class="hero-lead">
          Mình là Phan Quang Vinh, ở Hà Nội. Ở đây mình ghi lại những gì mình làm, học và rút ra. Có nguồn. Có số. Có tình huống thật.
        </p>
        <div class="btn-row">
          <a class="btn btn-dark" href="#ba-mang">Xem ba mảng</a>
          <a class="btn btn-outline" href="/bai-viet">Đọc bài viết</a>
        </div>
      </div>
      <div class="portrait">
        <img src="/pictures/opt/vinh-portrait.jpg" alt="Phan Quang Vinh (Kelvin)" width="800" height="1000" fetchpriority="high" />
        <span class="portrait-tag">Hà Nội · Tài chính Quốc tế FTU</span>
      </div>
    </div>
  </section>

  <div class="container"><WebinarPromo campaign="trang-chu" /></div>

  <section class="section" id="ba-mang">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Mình làm gì</span>
        <h2 class="section-title">Ba mảng, mỗi mảng một trang riêng</h2>
        <p class="section-sub">Mỗi mảng có bài viết, tài nguyên và lối vào riêng. Chọn mảng bạn quan tâm.</p>
      </div>
      <div class="grid grid-3">
        {pillars.map((p) => (
          <article class="card pillar" data-mod={p.mod}>
            <span class="pillar-no">{p.no}</span>
            <h3>{p.title}</h3>
            <p>{p.text}</p>
            <ul>{p.points.map((pt) => <li>{pt}</li>)}</ul>
            <a class="card-link" href={MODULES.find((m) => m.slug === p.mod)!.path}>{p.cta} →</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container quote">
      <blockquote>“Công nghệ không sinh ra để bạn cắm đầu làm nhiều việc hơn, mà là đòn bẩy để trả lại sự tự do và thời gian cho những điều thật sự quan trọng.”</blockquote>
      <cite>Phan Quang Vinh</cite>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Làm việc cùng mình</span>
        <h2 class="section-title">Ba cách để bắt đầu</h2>
      </div>
      <div class="grid grid-3">
        <article class="card num-card">
          <span class="num">01</span>
          <h3>Tự động hóa &amp; AI</h3>
          <p>Dựng quy trình bằng n8n và AI: báo cáo tự động, CRM, marketing automation, website. Nhận làm theo dự án.</p>
          <a class="card-link" href={SITE.zalo} target="_blank" rel="noopener noreferrer">Nhắn mình qua Zalo →</a>
        </article>
        <article class="card num-card">
          <span class="num">02</span>
          <h3>Học về thị trường cà phê</h3>
          <p>Webinar miễn phí và khóa học do HAP Academy tổ chức, giảng viên David Dũng. Mình là người giới thiệu.</p>
          <a class="card-link" href="/ca-phe#hoc">Xem lối vào →</a>
        </article>
        <article class="card num-card">
          <span class="num">03</span>
          <h3>Hiểu mình, dùng người đúng</h3>
          <p>DBL Strategy Report giúp bạn đọc năng lực và tiềm năng của bản thân, hoặc của đội ngũ bạn đang quản lý.</p>
          <a class="card-link" href="/dbl-code">Xem DBL Code →</a>
        </article>
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Bài viết</span>
        <h2 class="section-title">Mới nhất</h2>
      </div>
      {latest.length > 0
        ? <div class="grid grid-3">{latest.map((p) => <PostCard post={p} />)}</div>
        : <div class="empty"><strong>Bài đầu tiên sắp lên.</strong>Mình chỉ đăng khi mọi số liệu đều kiểm được nguồn.</div>}
      <div class="btn-row" style="margin-top:28px"><a class="btn btn-outline" href="/bai-viet">Xem tất cả bài viết</a></div>
    </div>
  </section>

  <section class="section">
    <div class="container"><NewsletterForm source="trang-chu" /></div>
  </section>

  <section class="section-tight">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Kết nối</span>
        <h2 class="section-title">Mình có mặt ở đây</h2>
      </div>
      <div class="links-row">
        {SOCIAL.map((s) => <a class="chip" href={s.url} target="_blank" rel="noopener noreferrer">{s.label} · {s.handle}</a>)}
        <a class="chip" href={SITE.zalo} target="_blank" rel="noopener noreferrer">Zalo · {SITE.zaloPhone}</a>
        <a class="chip" href={`mailto:${SITE.email}`}>{SITE.email}</a>
      </div>
    </div>
  </section>
</BaseLayout>
