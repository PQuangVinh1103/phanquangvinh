---
// Clean, single-hub personal brand site for Phan Quang Vinh (Kelvin)
---
<!DOCTYPE html>
<html lang="vi">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>PHAN QUANG VINH — Tư Duy Hệ Thống & Đòn Bẩy Tự Chủ</title>
  <meta name="description" content="Xây dựng tư duy hệ thống và ứng dụng công nghệ làm đòn bẩy tự chủ: bớt thao tác lặp lại, tối ưu quy trình và làm chủ thời gian của chính bạn." />
  <link rel="canonical" href="https://phanquangvinh.com" />

  <!-- Favicon -->
  <link rel="icon" type="image/png" href="/favicon.png" />
  <link rel="apple-touch-icon" href="/favicon.png" />

  <!-- Open Graph / Facebook / Zalo Preview -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://phanquangvinh.com" />
  <meta property="og:title" content="PHAN QUANG VINH — Tư Duy Hệ Thống & Đòn Bẩy Tự Chủ" />
  <meta property="og:description" content="Xây dựng tư duy hệ thống và ứng dụng công nghệ làm đòn bẩy tự chủ: bớt thao tác lặp lại, tối ưu quy trình và làm chủ thời gian của chính bạn." />
  <meta property="og:image" content="https://phanquangvinh.com/pictures/avatar_vinh.jpg" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:url" content="https://phanquangvinh.com" />
  <meta name="twitter:title" content="PHAN QUANG VINH — Tư Duy Hệ Thống & Đòn Bẩy Tự Chủ" />
  <meta name="twitter:description" content="Xây dựng tư duy hệ thống và ứng dụng công nghệ làm đòn bẩy tự chủ: bớt thao tác thủ công, giải phóng năng suất và làm chủ thời gian." />
  <meta name="twitter:image" content="https://phanquangvinh.com/pictures/avatar_vinh.jpg" />

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,600;12..96,700;12..96,800&family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet" />

  <style>
    /* =========================================
       DESIGN TOKENS — ELECTRIC COBALT SYSTEM
    ========================================= */
    :root {
      --brand-blue: #0066FF;
      --brand-blue-glow: rgba(0, 102, 255, 0.22);
      --brand-blue-soft: #EEF4FF;
      --brand-blue-dark: #004ecc;
      
      --bg-main: #FAFAFA;
      --bg-card: #FFFFFF;
      --bg-card-hover: #F8FAFC;
      --bg-dark: #090D16;
      
      --text-main: #0B132B;
      --text-muted: #5A6A85;
      --text-subtle: #8E9CAE;
      --text-inverted: #FFFFFF;
      
      --border-light: #E2E8F0;
      --border-subtle: #F1F5F9;
      
      --font-display: 'Bricolage Grotesque', -apple-system, sans-serif;
      --font-sans: 'Plus Jakarta Sans', -apple-system, sans-serif;
      
      --radius-sm: 8px;
      --radius-md: 14px;
      --radius-lg: 24px;
      --radius-full: 9999px;
      
      --shadow-soft: 0 4px 20px -2px rgba(0, 0, 0, 0.04);
      --shadow-hover: 0 14px 32px -4px rgba(0, 102, 255, 0.12);
      --shadow-float: 0 20px 45px -10px rgba(11, 19, 43, 0.14);
      
      --max-width: 1160px;
    }

    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      scroll-behavior: smooth;
      font-size: 16px;
    }

    body {
      background: radial-gradient(circle at 50% -10%, rgba(0, 102, 255, 0.04) 0%, transparent 50%), var(--bg-main);
      color: var(--text-main);
      font-family: var(--font-sans);
      line-height: 1.6;
      -webkit-font-smoothing: antialiased;
      overflow-x: hidden;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    .container {
      width: 100%;
      max-width: var(--max-width);
      margin: 0 auto;
      padding: 0 1.5rem;
    }

    /* =========================================
       HEADER NAVIGATION & MODERN WORDMARK LOGO
    ========================================= */
    .site-header {
      position: sticky;
      top: 0;
      z-index: 100;
      background: rgba(250, 250, 250, 0.90);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
      border-bottom: 1px solid var(--border-subtle);
      transition: all 0.2s ease;
    }

    .header-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      height: 76px;
    }

    /* MODERN WORDMARK LOGO */
    .brand-logo {
      display: flex;
      align-items: center;
      gap: 0.65rem;
    }

    .logo-text-wrap {
      display: flex;
      flex-direction: column;
    }

    .logo-name {
      font-family: var(--font-display);
      font-weight: 800;
      font-size: 1.15rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--text-main);
      line-height: 1.1;
    }

    .logo-tag {
      font-size: 0.68rem;
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--brand-blue);
      margin-top: 2px;
    }

    .brand-dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: var(--brand-blue);
      display: inline-block;
      box-shadow: 0 0 10px var(--brand-blue);
    }

    .nav-links {
      display: flex;
      align-items: center;
      gap: 2.2rem;
      list-style: none;
    }

    .nav-link {
      font-size: 0.92rem;
      font-weight: 600;
      color: var(--text-muted);
      transition: color 0.15s ease;
    }

    .nav-link:hover {
      color: var(--brand-blue);
    }

    .nav-cta {
      display: inline-flex;
      align-items: center;
      gap: 0.45rem;
      padding: 0.6rem 1.25rem;
      background: var(--text-main);
      color: var(--text-inverted);
      font-size: 0.88rem;
      font-weight: 700;
      border-radius: var(--radius-full);
      transition: all 0.2s ease;
    }

    .nav-cta:hover {
      background: var(--brand-blue);
      transform: translateY(-1px);
      box-shadow: 0 6px 16px var(--brand-blue-glow);
    }

    /* =========================================
       HERO SECTION
    ========================================= */
    .hero-section {
      padding: 4.5rem 0 3.5rem;
      position: relative;
    }

    .hero-grid {
      display: grid;
      grid-template-columns: 1.15fr 0.85fr;
      gap: 3.5rem;
      align-items: center;
    }

    .hero-copy {
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
    }

    .hero-headline {
      font-family: var(--font-display);
      font-size: clamp(2.35rem, 4.4vw, 3.65rem);
      font-weight: 800;
      line-height: 1.14;
      letter-spacing: -0.03em;
      color: var(--text-main);
    }

    .hero-headline .highlight-blue {
      color: var(--brand-blue);
      position: relative;
      display: inline-block;
    }

    .hero-description {
      font-size: clamp(1.05rem, 1.25vw, 1.18rem);
      color: var(--text-muted);
      line-height: 1.68;
      max-width: 530px;
    }

    .hero-actions {
      display: flex;
      align-items: center;
      gap: 1rem;
      flex-wrap: wrap;
      margin-top: 0.4rem;
    }

    .btn-primary {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      padding: 0.9rem 1.8rem;
      background: var(--brand-blue);
      color: var(--text-inverted);
      font-weight: 700;
      font-size: 0.98rem;
      border-radius: var(--radius-full);
      box-shadow: 0 8px 24px var(--brand-blue-glow);
      transition: all 0.2s ease;
    }

    .btn-primary:hover {
      background: var(--brand-blue-dark);
      transform: translateY(-2px);
      box-shadow: 0 12px 28px rgba(0, 102, 255, 0.35);
    }

    .btn-secondary {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      padding: 0.9rem 1.6rem;
      background: var(--bg-card);
      color: var(--text-main);
      font-weight: 600;
      font-size: 0.95rem;
      border: 1px solid var(--border-light);
      border-radius: var(--radius-full);
      transition: all 0.2s ease;
    }

    .btn-secondary:hover {
      border-color: var(--brand-blue);
      color: var(--brand-blue);
      background: var(--brand-blue-soft);
      transform: translateY(-1px);
    }

    .hero-badges {
      display: flex;
      align-items: center;
      gap: 1.25rem;
      padding-top: 1.25rem;
      border-top: 1px solid var(--border-light);
      margin-top: 0.5rem;
      flex-wrap: wrap;
    }

    .hero-badge-item {
      display: flex;
      align-items: center;
      gap: 0.45rem;
      font-size: 0.85rem;
      font-weight: 600;
      color: var(--text-muted);
    }

    .hero-badge-item svg {
      color: var(--brand-blue);
      flex-shrink: 0;
    }

    /* HERO VISUAL (PROPERLY CENTERED PORTRAIT WITH TECH GRID & LEVERAGE BADGE) */
    .hero-visual {
      position: relative;
    }

    .portrait-card {
      position: relative;
      border-radius: var(--radius-lg);
      overflow: hidden;
      background: #0B132B;
      box-shadow: var(--shadow-float);
      aspect-ratio: 4/5;
      border: 1px solid rgba(255, 255, 255, 0.12);
    }

    .portrait-img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center 15%;
      display: block;
      filter: contrast(1.04) brightness(1.02);
    }

    /* Tech Grid Overlay */
    .tech-grid-overlay {
      position: absolute;
      inset: 0;
      background-image: 
        linear-gradient(to right, rgba(0, 102, 255, 0.08) 1px, transparent 1px),
        linear-gradient(to bottom, rgba(0, 102, 255, 0.08) 1px, transparent 1px);
      background-size: 24px 24px;
      pointer-events: none;
    }

    .tech-glow-overlay {
      position: absolute;
      inset: 0;
      background: radial-gradient(circle at 85% 90%, rgba(0, 102, 255, 0.35) 0%, transparent 65%),
                  linear-gradient(to top, rgba(11, 19, 43, 0.75) 0%, transparent 45%);
      pointer-events: none;
    }

    /* Floating Automation Badge */
    .automation-float-card {
      position: absolute;
      bottom: -18px;
      left: -18px;
      background: rgba(255, 255, 255, 0.96);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border: 1px solid rgba(255, 255, 255, 0.85);
      border-radius: var(--radius-md);
      padding: 1.05rem 1.3rem;
      box-shadow: 0 18px 38px rgba(11, 19, 43, 0.12);
      max-width: 290px;
      animation: floatSlow 5s ease-in-out infinite alternate;
    }

    @keyframes floatSlow {
      0% { transform: translateY(0px); }
      100% { transform: translateY(-6px); }
    }

    .float-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 0.45rem;
    }

    .pulse-status {
      display: flex;
      align-items: center;
      gap: 0.45rem;
      font-size: 0.74rem;
      font-weight: 700;
      color: var(--brand-blue);
      text-transform: uppercase;
      letter-spacing: 0.06em;
    }

    .pulse-dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: var(--brand-blue);
      box-shadow: 0 0 8px var(--brand-blue);
      animation: pulse 2s infinite;
    }

    @keyframes pulse {
      0%, 100% { opacity: 1; transform: scale(1); }
      50% { opacity: 0.4; transform: scale(0.85); }
    }

    .float-body {
      font-size: 0.88rem;
      font-weight: 600;
      color: var(--text-main);
      line-height: 1.4;
    }

    .float-metric {
      display: inline-block;
      margin-top: 0.35rem;
      font-size: 0.78rem;
      color: var(--text-muted);
      font-weight: 500;
    }

    /* =========================================
       SECTION: CORE PRINCIPLES & FRAMEWORKS
    ========================================= */
    .section {
      padding: 5rem 0;
    }

    .section-header {
      margin-bottom: 2.75rem;
    }

    .section-title {
      font-family: var(--font-display);
      font-size: clamp(1.8rem, 3vw, 2.35rem);
      font-weight: 800;
      letter-spacing: -0.02em;
      color: var(--text-main);
      margin-bottom: 0.5rem;
    }

    .section-subtitle {
      font-size: 1.05rem;
      color: var(--text-muted);
      max-width: 620px;
      line-height: 1.6;
    }

    .resources-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
      gap: 1.75rem;
    }

    .resource-card {
      background: var(--bg-card);
      border: 1px solid var(--border-light);
      border-radius: var(--radius-md);
      padding: 2rem;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      transition: all 0.25s ease;
      box-shadow: var(--shadow-soft);
    }

    .resource-card:hover {
      border-color: var(--brand-blue);
      transform: translateY(-4px);
      box-shadow: var(--shadow-hover);
    }

    .resource-tag {
      display: inline-block;
      padding: 0.3rem 0.8rem;
      background: var(--brand-blue-soft);
      color: var(--brand-blue);
      font-size: 0.78rem;
      font-weight: 700;
      border-radius: var(--radius-full);
      margin-bottom: 1.1rem;
      align-self: flex-start;
    }

    .resource-title {
      font-family: var(--font-display);
      font-size: 1.32rem;
      font-weight: 700;
      line-height: 1.35;
      color: var(--text-main);
      margin-bottom: 0.85rem;
    }

    .resource-desc {
      font-size: 0.93rem;
      color: var(--text-muted);
      line-height: 1.65;
      margin-bottom: 1.5rem;
    }

    .resource-bottom {
      border-top: 1px dashed var(--border-light);
      padding-top: 1rem;
      margin-top: auto;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .resource-takeaway {
      font-size: 0.84rem;
      color: var(--brand-blue);
      font-weight: 600;
    }

    .resource-action {
      display: inline-flex;
      align-items: center;
      gap: 0.3rem;
      font-size: 0.82rem;
      font-weight: 700;
      color: var(--text-main);
      transition: color 0.15s ease;
    }

    .resource-card:hover .resource-action {
      color: var(--brand-blue);
    }

    /* =========================================
       SECTION: THREE WAYS I CAN HELP
    ========================================= */
    .help-section {
      background: #F1F5F9;
      border-top: 1px solid var(--border-light);
      border-bottom: 1px solid var(--border-light);
      padding: 5rem 0;
    }

    .help-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: 1.5rem;
    }

    .help-card {
      background: var(--bg-card);
      border: 1px solid var(--border-light);
      border-radius: var(--radius-md);
      padding: 2.25rem 2rem;
      transition: all 0.2s ease;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }

    .help-card:hover {
      border-color: var(--brand-blue);
      box-shadow: var(--shadow-hover);
    }

    .help-number {
      font-family: var(--font-display);
      font-size: 2.2rem;
      font-weight: 800;
      color: var(--brand-blue);
      line-height: 1;
      margin-bottom: 1.1rem;
      opacity: 0.95;
    }

    .help-card-title {
      font-family: var(--font-display);
      font-size: 1.25rem;
      font-weight: 700;
      color: var(--text-main);
      margin-bottom: 0.65rem;
    }

    .help-card-desc {
      font-size: 0.92rem;
      color: var(--text-muted);
      line-height: 1.65;
      margin-bottom: 1.5rem;
    }

    .help-card-cta {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      font-size: 0.88rem;
      font-weight: 700;
      color: var(--brand-blue);
      margin-top: auto;
    }

    .help-card-cta svg {
      transition: transform 0.2s ease;
    }

    .help-card:hover .help-card-cta svg {
      transform: translateX(4px);
    }

    /* =========================================
       SECTION: ABOUT PHAN QUANG VINH (KELVIN)
    ========================================= */
    .about-section {
      padding: 5rem 0;
    }

    .about-box {
      background: var(--bg-card);
      border: 1px solid var(--border-light);
      border-radius: var(--radius-lg);
      padding: 3.5rem;
      box-shadow: var(--shadow-soft);
      display: grid;
      grid-template-columns: 1fr 1.6fr;
      gap: 3.5rem;
      align-items: center;
    }

    .about-visual-small {
      border-radius: var(--radius-md);
      overflow: hidden;
      aspect-ratio: 1/1;
      background: #0B132B;
      position: relative;
    }

    .about-visual-small img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center 20%;
    }

    .about-content h2 {
      font-family: var(--font-display);
      font-size: 2.1rem;
      font-weight: 800;
      color: var(--text-main);
      margin-bottom: 1.1rem;
      letter-spacing: -0.02em;
    }

    .about-content p {
      font-size: 1.02rem;
      color: var(--text-muted);
      line-height: 1.75;
      margin-bottom: 1.2rem;
    }

    .about-content .about-quote {
      font-size: 1.05rem;
      font-weight: 600;
      color: var(--brand-blue);
      border-left: 3px solid var(--brand-blue);
      padding-left: 1.1rem;
      margin-top: 1.75rem;
      line-height: 1.6;
    }

    /* =========================================
       FOOTER
    ========================================= */
    .site-footer {
      background: var(--bg-card);
      border-top: 1px solid var(--border-light);
      padding: 3.25rem 0;
      font-size: 0.9rem;
      color: var(--text-muted);
    }

    .footer-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 1.5rem;
    }

    .footer-links {
      display: flex;
      align-items: center;
      gap: 1.75rem;
    }

    .footer-link {
      font-weight: 600;
      transition: color 0.15s ease;
    }

    .footer-link:hover {
      color: var(--brand-blue);
    }

    /* =========================================
       RESPONSIVE BREAKPOINTS
    ========================================= */
    @media (max-width: 900px) {
      .hero-grid {
        grid-template-columns: 1fr;
        gap: 2.75rem;
      }

      .hero-visual {
        max-width: 420px;
        margin: 0 auto;
      }

      .automation-float-card {
        bottom: -15px;
        left: 10px;
        right: 10px;
        max-width: none;
      }

      .about-box {
        grid-template-columns: 1fr;
        padding: 2.25rem;
        gap: 2rem;
      }

      .about-visual-small {
        max-width: 260px;
      }
    }

    @media (max-width: 640px) {
      .nav-links {
        display: none;
      }

      .hero-section {
        padding: 3rem 0 2.5rem;
      }

      .hero-actions {
        flex-direction: column;
        align-items: stretch;
      }

      .btn-primary, .btn-secondary {
        width: 100%;
      }
    }
  </style>
</head>

<body>

  <!-- HEADER NAVIGATION & MODERN LOGO -->
  <header class="site-header">
    <div class="container">
      <div class="header-inner">
        <a href="/" class="brand-logo">
          <span class="brand-dot"></span>
          <div class="logo-text-wrap">
            <span class="logo-name">PHAN QUANG VINH</span>
            <span class="logo-tag">Tư Duy & Tự Động Hóa</span>
          </div>
        </a>
        
        <nav>
          <ul class="nav-links">
            <li><a href="#principles" class="nav-link">Tư duy cốt lõi</a></li>
            <li><a href="#how-i-help" class="nav-link">Cách tôi giúp bạn</a></li>
            <li><a href="#about" class="nav-link">Về Kelvin</a></li>
          </ul>
        </nav>

        <a href="https://zalo.me/g/vjrvtu846" target="_blank" rel="noopener noreferrer" class="nav-cta">
          <span>Vào Nhóm Zalo</span>
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17L17 7"/><path d="M7 7h10v10"/></svg>
        </a>
      </div>
    </div>
  </header>

  <main>
    <!-- HERO SECTION -->
    <section class="hero-section">
      <div class="container">
        <div class="hero-grid">
          
          <!-- LEFT: COPYWRITING -->
          <div class="hero-copy">
            <h1 class="hero-headline">
              Thời gian của bạn không sinh ra để <span class="highlight-blue">làm việc lặp lại.</span>
            </h1>

            <p class="hero-description">
              Học cách xây dựng tư duy hệ thống và biến công nghệ thành đòn bẩy tự chủ: bớt thao tác thủ công, giải phóng năng suất và làm chủ thời gian của chính bạn.
            </p>

            <div class="hero-actions">
