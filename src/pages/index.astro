---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
import WebinarPromo from '../components/WebinarPromo.astro';
import { SITE, SOCIAL, MODULES, FIELD_STORY } from '../config/site';
import { getPublishedPosts } from '../lib/posts';

const latest = (await getPublishedPosts()).slice(0, 3);

const pillars = [
  { mod: 'ca-phe', no: 'Lĩnh vực 01', title: 'Cà phê và nông sản', text: FIELD_STORY['ca-phe'], cta: 'Đi vào cà phê và nông sản' },
  { mod: 'dbl-code', no: 'Lĩnh vực 02', title: 'Con người · DBL Code', text: FIELD_STORY['dbl-code'], cta: 'Đi vào DBL Code' },
  { mod: 'tai-san-so', no: 'Lĩnh vực 03', title: 'Tài sản số', text: FIELD_STORY['tai-san-so'], cta: 'Đi vào tài sản số' },
];

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: SITE.name,
  alternateName: SITE.nickname,
  url: SITE.url,
  image: new URL(SITE.portrait, SITE.url).toString(),
  brand: SITE.brand,
  jobTitle: SITE.jobTitle,
  knowsAbout: ['Thị trường cà phê', 'Phát triển con người', 'Phát triển sự nghiệp', 'Tài sản mã hóa', 'RWA'],
  sameAs: SOCIAL.map((s) => s.url),
};
const website = { '@context': 'https://schema.org', '@type': 'WebSite', name: SITE.name, alternateName: [SITE.alternateName, SITE.nickname], url: `${SITE.url}/`, inLanguage: 'vi' };
---
<BaseLayout title="Phan Quang Vinh | Cà phê, Phát triển Con người & Sự nghiệp, Tài sản số" description={SITE.description} jsonLd={[person, website]}>
  <section class="hero">
    <div class="container hero-grid">
      <div>
        <span class="eyebrow">Phan Quang Vinh · Kelvin</span>
        <h1>Mình thích hiểu sâu một việc, <span class="accent">rồi đặt nó vào bức tranh lớn.</span></h1>
        <p class="hero-lead">
          Tốt nghiệp Đại học Ngoại Thương, chuyên ngành Tài chính Quốc tế. Mình đang trên hành trình gây dựng một sự nghiệp thịnh vượng đúng nghĩa. Hiện tại mình đang công tác ở Hà Nội, làm việc về lĩnh vực tư vấn cà phê nông sản, phát triển con người và tài sản số. Ở đây mình kể cách mình làm và điều mình học được. Hãy kết nối với mình nhé!
        </p>
        <div class="btn-row">
          <a class="btn btn-dark" href="#viec-dang-lam">Xem mình đang làm gì</a>
          <a class="btn btn-outline" href="/bai-viet">Đọc bài viết</a>
        </div>
      </div>
      <div class="portrait">
        <img src="/pictures/opt/vinh-portrait.jpg" alt="Phan Quang Vinh (Kelvin)" width="800" height="1000" fetchpriority="high" />
        <span class="portrait-tag">Hà Nội</span>
      </div>
    </div>
  </section>

  <div class="container"><WebinarPromo campaign="trang-chu" /></div>

  <section class="section" id="viec-dang-lam">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Công việc của mình</span>
        <h2 class="section-title">Những việc mình đang theo đuổi</h2>
        <p class="section-sub">Mỗi nơi một câu chuyện riêng. Bạn cứ chọn nơi bạn quan tâm.</p>
      </div>
      <div class="grid grid-3">
        {pillars.map((p) => (
          <article class="card pillar" data-mod={p.mod}>
            <span class="pillar-no">{p.no}</span>
            <h3>{p.title}</h3>
            <p>{p.text}</p>
            <a class="card-link" href={MODULES.find((m) => m.slug === p.mod)!.path}>{p.cta} →</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container quote">
      <blockquote>“Công nghệ không sinh ra để bạn cắm đầu làm nhiều việc hơn, mà là đòn bẩy để trả lại sự tự do và thời gian cho những điều thật sự quan trọng.”</blockquote>
      <cite>Phan Quang Vinh</cite>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Cùng làm việc</span>
        <h2 class="section-title">Nếu bạn muốn làm việc cùng mình</h2>
      </div>
      <div class="grid grid-3">
        <article class="card num-card">
          <span class="num">01</span>
          <h3>Tự động hóa &amp; AI</h3>
          <p>Bạn có một quy trình đang rối? Mình ngồi lại cùng bạn, nhìn cả bức tranh trước, rồi mới chọn công cụ. Mình dùng n8n và AI để việc chạy nhanh và gọn hơn.</p>
          <a class="card-link" href={SITE.zalo} target="_blank" rel="noopener noreferrer">Nhắn mình qua Zalo →</a>
        </article>
        <article class="card num-card">
          <span class="num">02</span>
          <h3>Học về thị trường cà phê</h3>
          <p>Webinar miễn phí và khóa học do HAP Commodities Consulting tổ chức, giảng viên David Dũng. Mình làm cầu nối giới thiệu.</p>
          <a class="card-link" href="/ca-phe#hoc">Xem lối vào →</a>
        </article>
        <article class="card num-card">
          <span class="num">03</span>
          <h3>Hiểu mình, dùng người đúng</h3>
          <p>DBL Strategy Report giúp bạn hiểu rõ năng lực và tiềm năng của mình, hoặc của đội ngũ bạn đang dẫn dắt.</p>
          <a class="card-link" href="/dbl-code">Xem DBL Code →</a>
        </article>
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Bài viết</span>
        <h2 class="section-title">Mới nhất</h2>
      </div>
      {latest.length > 0
        ? <div class="grid grid-3">{latest.map((p) => <PostCard post={p} />)}</div>
        : <div class="empty"><strong>Bài đầu tiên sắp lên.</strong>Mình đang hoàn thiện, bạn quay lại sau nhé.</div>}
      <div class="btn-row" style="margin-top:28px"><a class="btn btn-outline" href="/bai-viet">Xem tất cả bài viết</a></div>
    </div>
  </section>

  <section class="section">
    <div class="container"><NewsletterForm source="trang-chu" /></div>
  </section>

  <section class="section-tight">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Kết nối</span>
        <h2 class="section-title">Mình có mặt ở đây</h2>
      </div>
      <div class="links-row">
        {SOCIAL.map((s) => <a class="chip" href={s.url} target="_blank" rel="noopener noreferrer">{s.label} · {s.handle}</a>)}
        <a class="chip" href={SITE.zalo} target="_blank" rel="noopener noreferrer">Zalo · {SITE.zaloPhone}</a>
        <a class="chip" href={`mailto:${SITE.email}`}>{SITE.email}</a>
      </div>
    </div>
  </section>
</BaseLayout>
