---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE, SOCIAL, FIELD_STORY } from '../config/site';

const projects = (await getCollection('projects')).sort((a, b) => b.data.order - a.data.order);

const methods = [
  { t: 'Dựng video tự động', d: 'Một bộ công cụ đóng gói sẵn để dựng và hoàn thiện video nhanh hơn, mà chất lượng vẫn đồng đều.' },
  { t: 'Research thông tin', d: 'Một quy trình tìm, đối chiếu và ghi lại nguồn, để mỗi bài viết dựa trên dữ liệu kiểm được.' },
  { t: 'Hệ thống hóa truyền thông', d: 'Từ ý tưởng, kịch bản đến lịch đăng và chăm sóc người xem, mỗi bước đều có quy trình riêng.' },
];

const roles = [
  { tag: 'Lĩnh vực 01', t: 'Cà phê và nông sản', d: FIELD_STORY['ca-phe'], href: '/ca-phe' },
  { tag: 'Lĩnh vực 02', t: 'Con người · DBL Code', d: FIELD_STORY['dbl-code'], href: '/dbl-code' },
  { tag: 'Lĩnh vực 03', t: 'Tài sản số', d: FIELD_STORY['tai-san-so'], href: '/tai-san-so' },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  mainEntity: { '@type': 'Person', name: SITE.name, url: SITE.url, sameAs: SOCIAL.map((s) => s.url), alumniOf: 'Đại học Ngoại thương' },
};
---
<BaseLayout title="Về Vinh — Phan Quang Vinh (Kelvin)" description="Phan Quang Vinh (Kelvin), Hà Nội. Tốt nghiệp Đại học Ngoại thương, ngành Tài chính Quốc tế. Làm việc ở cà phê nông sản, quản lý con người và tài sản số. Nhận dự án tự động hóa và AI." jsonLd={jsonLd}>
  <section class="hero">
    <div class="container hero-grid">
      <div>
        <span class="eyebrow">Về Vinh</span>
        <h1>Mình là Vinh. Mình thích hiểu sâu một việc, <span class="accent">rồi đặt nó vào bức tranh lớn.</span></h1>
        <p class="hero-lead">
          Tốt nghiệp Đại học Ngoại thương, ngành Tài chính Quốc tế. Mình đang công tác ở Hà Nội, làm việc về lĩnh vực tư vấn cà phê nông sản, quản lý con người và tài sản số. Ở đây mình kể cách mình làm và điều mình học được.
        </p>
        <div class="btn-row">
          <a class="btn btn-dark" href="#lien-he">Liên hệ</a>
          <a class="btn btn-outline" href="#du-an">Xem dự án</a>
        </div>
      </div>
      <div class="portrait">
        <img src="/pictures/opt/vinh-portrait-2.jpg" alt="Phan Quang Vinh (Kelvin)" width="800" height="1000" loading="lazy" />
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="container">
      <div class="stat-row two">
        <div class="stat"><b>~83.000 trang</b><span>báo cáo do hệ thống n8n tự tạo trong 2 ngày</span></div>
        <div class="stat"><b>3 giờ</b><span>dựng một website hoàn chỉnh bằng AI, làm một mình</span></div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Đang làm</span>
        <h2 class="section-title">Công việc của mình</h2>
      </div>
      <div class="grid grid-3">
        {roles.map((r) => (
          <article class="card pillar" data-mod={r.href.slice(1)}>
            <span class="pillar-no">{r.tag}</span>
            <h3>{r.t}</h3>
            <p>{r.d}</p>
            <a class="card-link" href={r.href}>Xem chi tiết →</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Cách mình làm việc</span>
        <h2 class="section-title">Mình dùng AI để việc gọn và nhanh hơn</h2>
        <p class="section-sub">Công cụ chỉ là phương tiện. Mình đóng gói những phần lặp lại thành quy trình, để thời gian dành cho phần cần suy nghĩ.</p>
      </div>
      <div class="grid grid-3">
        {methods.map((m) => (
          <article class="card">
            <h3>{m.t}</h3>
            <p>{m.d}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="du-an">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Dự án</span>
        <h2 class="section-title">Vài việc mình đã làm</h2>
        <p class="section-sub">Nhận làm theo dự án: tự động hóa quy trình, báo cáo, CRM, website.</p>
      </div>
      <div class="grid grid-3">
        {projects.map((p) => {
          const hasLink = p.data.link && p.data.link !== '#';
          return (
            <article class="card">
              <div class="project-thumb" style={`background:linear-gradient(135deg,${p.data.thumbFrom},${p.data.thumbTo})`}></div>
              <div class="tags">{p.data.tags.map((t) => <span class="tag">{t}</span>)}</div>
              <h3>{p.data.titleVi}</h3>
              <p>{p.data.excerptVi}</p>
              <strong style="color:var(--forest);font-size:.9rem">{p.data.resultVi}</strong>
              {hasLink && <a class="card-link" href={p.data.link}>Xem dự án →</a>}
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <section class="section section-alt" id="lien-he">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Liên hệ</span>
        <h2 class="section-title">Cứ nhắn mình nhé</h2>
        <p class="section-sub">Zalo là nhanh nhất. Email cho việc cần gửi tài liệu.</p>
      </div>
      <div class="btn-row">
        <a class="btn btn-primary" href={SITE.zalo} target="_blank" rel="noopener noreferrer">Zalo {SITE.zaloPhone}</a>
        <a class="btn btn-outline" href={`mailto:${SITE.email}`}>{SITE.email}</a>
      </div>
      <div class="links-row" style="margin-top:22px">
        {SOCIAL.map((s) => <a class="chip" href={s.url} target="_blank" rel="noopener noreferrer">{s.label}</a>)}
      </div>
    </div>
  </section>
</BaseLayout>
